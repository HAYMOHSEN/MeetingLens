{
  "name": "meetinglens-pwa",
  "private": true,
  "version": "3.2.1",
  "description": "Local camera effects, photo editing, whiteboard capture and session tools for MeetingLens.",
  "scripts": {
    "capture:store-assets": "node scripts/capture-store-assets.mjs",
    "generate:store-art": "node scripts/generate-store-art.cjs",
    "test": "node scripts/verify-studio.cjs && node scripts/verify-offline.cjs",
    "test:offline": "node scripts/verify-offline.cjs",
    "test:backgrounds": "node scripts/verify-backgrounds.cjs",
    "test:advanced": "node scripts/verify-advanced.cjs",
    "test:session": "node scripts/verify-session.cjs",
    "test:photo": "node scripts/verify-photo-workbench.cjs",
    "test:native-report": "node scripts/verify-native-report.cjs",
    "test:offline-tools": "node scripts/verify-offline-tools.cjs",
    "test:release": "node scripts/verify-release.cjs",
    "test:live-backgrounds": "node scripts/verify-live-backgrounds.cjs",
    "test:background-compositor": "node scripts/verify-background-compositor.cjs",
    "test:vision": "node assets/vendor/vision/verify-vision.cjs",
    "test:frame-pairing": "node scripts/verify-frame-pairing.cjs",
    "test:person-worker": "node scripts/verify-person-worker.cjs"
  },
  "devDependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "playwright": "^1.54.0"
  }
