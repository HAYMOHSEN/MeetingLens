<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22621.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MeetingLens.Camera</AssemblyName>
    <Version>3.3.0</Version>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <!-- Pinned stable SDK; installed Evergreen Runtime supplies security updates. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <Content Include="../../index.html;../../privacy.html;../../terms.html;../../offline.html;../../native-capabilities.html;../../photo-workbench.html;../../manifest.webmanifest;../../service-worker.js">
      <Link>web/%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="../../assets/**/*" Exclude="../../assets/store-assets/**;../../assets/**/verify-*.cjs;../../assets/**/*.md;../../assets/**/VALIDATION.json">
      <Link>web/assets/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <Target Name="CheckBundledApp" BeforeTargets="Build">
    <Error Condition="!Exists('../../index.html')" Text="The complete MeetingLens repository is required to bundle the camera UI." />
  </Target>
</Project>
